{
  // This project uses CrewAI 1.15.5's declarative JSONC crew format.
  "name": "Smart Shopping & Price-Comparison AI Agent",

  // Agent IDs must exactly match files in agents/.
  "agents": [
    "product_search_specialist",
    "price_comparison_analyst",
    "product_recommendation_advisor"
  ],

  // Sequential order matters: search -> comparison -> recommendation.
  "tasks": [
    {
      "name": "product_search",
      "description": "Research the user's request: {product_query}\n\nUse Exa Search to find candidate products and the website-reading tool to verify product pages. Find up to five UNIQUE products that match the user's budget, intended use, preferred features, and buyer location, or fewer when the user explicitly requests a lower count. A different seller or cosmetic variation of the same model does not count as a unique product unless the specifications materially differ.\n\nFor every product, capture: exact product name/model, listed price and original currency, original price only when sourced, key specifications as name/value pairs, seller/store, availability, warranty, shipping cost and Cambodia delivery status when relevant, direct product URL, verification status, unverified fields, and brief verification notes. Record excluded, blocked, duplicate, stale, CAPTCHA-protected, or empty candidates as research issues instead of usable products.\n\nEfficiency limits:\n- Use one focused Exa search first and no more than two Exa searches total.\n- Open only the most promising direct product pages. Verify no more than five usable product pages plus one replacement page if a candidate is blocked, duplicated, or irrelevant.\n- Stop using tools as soon as the requested number of products is verified or the limits above are reached.\n- Keep notes compact. Do not copy long website passages into the result.\n\nReliability rules:\n- Never invent or estimate a price, discount, seller, review score, stock status, warranty, shipping cost, or URL.\n- Open only HTTP(S) URLs returned by Exa Search. Never construct, guess, or modify retailer or product URLs from memory.\n- If Exa returns an authentication/API error or no usable results, stop searching and return an empty products list with a clear research issue and shortfall reason. Do not fall back to guessed retailer pages.\n- Use null for missing structured fields and list their names in unverified_fields; an unknown shipping cost is not zero.\n- Keep currencies exactly as listed. Do not convert currencies unless a cited conversion rate is available.\n- Deduplicate products by model and material specifications.\n- If fewer products can be verified within the tool limits, return the verified products and explicitly state the shortfall instead of fabricating entries.\n\nReturn only the structured ProductSearchResult requested by the task schema. Do not return Markdown, raw search results, or commentary outside that structure.",
      "expected_output": "A ProductSearchResult containing interpreted user requirements, zero to five unique ProductEvidence records with exact source URLs, structured prices and specifications, verification status and missing fields, plus ResearchIssue records and a shortfall reason when applicable.",
      "agent": "product_search_specialist",
      "output_pydantic": {
        "python": "tools.schemas.ProductSearchResult"
      }
    },
    {
      "name": "price_comparison",
      "description": "Using the structured ProductSearchResult context for {product_query}, compare every candidate product without changing its sourced identity, prices, currencies, seller, or URLs. For each product analyze listed price, original price only when sourced, shipping cost, total known purchase cost, warranty, seller reliability evidence, return policy, advantages, disadvantages, and verification status.\n\nNormally use only the Product Search evidence. Use Exa Search only when one critical fact would change the winner and is missing, stale, or conflicting. Make at most one targeted Exa verification search, include its exact source URL, and do not perform broad new product discovery or repeat searches already completed by Product Search.\n\nSet total_cost_status to complete only when every required known component uses the same currency. If shipping, tax, import duty, or another required component is unknown, use incomplete, leave total_known_cost null unless it is clearly labeled as only the known subtotal, list every missing component, and never treat a missing amount as zero. Use not_calculable when currencies conflict. Do not mix currencies in a NormalPriceRange. Create a normal range only from comparable verified products in the same currency, and identify its sample. Use null for seller reliability or return policy when the evidence does not establish it.\n\nCreate BestValueDeal only when the exact price, seller, and URL are verified. Return only the structured PriceComparisonResult requested by the task schema. Do not return Markdown or commentary outside that structure, and never invent products, prices, sellers, reviews, stock claims, or purchase links.",
      "expected_output": "A PriceComparisonResult containing one ProductComparison for every search candidate, zero or more same-currency NormalPriceRange records, an optional fully verified BestValueDeal, and explicit limitations for missing or inconsistent evidence.",
      "agent": "price_comparison_analyst",
      "context": ["product_search"],
      "output_pydantic": {
        "python": "tools.schemas.PriceComparisonResult"
      }
    },
    {
      "name": "final_recommendation",
      "description": "Using ONLY the structured ProductSearchResult and PriceComparisonResult context for {product_query}, produce one JSON object that the project callback can validate as FinalRecommendationResult.\n\nCopy UserRequirements from the research context without changing its meaning. Select a recommendation only when the evidence supports it; otherwise set recommendation to null and confidence to insufficient_evidence. Preserve exact product models, sourced prices, currencies, sellers, verification statuses, and URLs. Rank no more than four alternatives. Never create or alter prices, URLs, reviews, seller claims, stock, warranty, shipping claims, or currencies. Use null for missing optional fields and explain missing or conflicting facts in limitations_and_unverified_information.\n\nReturn JSON with exactly these top-level keys and nested fields:\n- requirements: product, budget, buyer_location, important_preferences (array), requested_product_count (integer or null), research_date (YYYY-MM-DD).\n- recommendation: null or an object with exact_product_model, verified_price (Money or null), seller, availability, warranty, delivery_information, source_url, and why_it_wins.\n- alternatives: an array of at most four objects with rank, exact_product_model, price (Money or null), seller, main_advantage, verification_status, and source_url.\n- advantages: an array of strings.\n- limitations_and_unverified_information: an array of strings.\n- confidence: high, medium, low, or insufficient_evidence.\n- buying_checklist: an object with non-empty strings for exact_model_sku, current_price, stock, delivery_cost, taxes, warranty, return_policy, seller_identity, and secure_payment. Each string must state the exact fact the buyer should confirm.\n- sources: an array of objects with product_name and url.\n\nA Money object has amount as a non-negative decimal string, currency, and label (string or null). verification_status must be verified, partially_verified, could_not_verify, or unavailable. Include a source object for every URL used by the recommendation or alternatives. Return only the JSON object with no Markdown fences or commentary; the project callback will validate it and render report.md.",
      "expected_output": "One valid JSON object matching FinalRecommendationResult: copied user requirements, an optional evidence-supported recommendation, ranked alternatives, advantages, explicit limitations, confidence, a complete buying checklist, and exact source references.",
      "agent": "product_recommendation_advisor",
      "context": ["product_search", "price_comparison"],
      "callback": {
        "python": "tools.reporting.save_recommendation_report"
      }
    }
  ],

  "process": "sequential",
  "verbose": true,
  "memory": false,
  "planning": false,
  "cache": true,
  "tracing": false,
  "before_kickoff_callbacks": [
    {
      "python": "tools.runtime_checks.validate_runtime"
    }
  ],

  // A runnable sample default. Override it with `crewai run --inputs`.
  "inputs": {
    "product_query": "Find the best gaming laptop under $1000 available to a buyer in Cambodia. Compare at least five products and recommend the best value."
  }
}
