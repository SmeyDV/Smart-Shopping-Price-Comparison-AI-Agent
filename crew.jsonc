{
  // This project uses CrewAI 1.15.5's declarative JSONC crew format.
  "name": "Smart Shopping & Price-Comparison AI Agent",

  // Agent IDs must exactly match files in agents/.
  "agents": [
    "product_search_specialist",
    "price_comparison_analyst",
    "product_recommendation_advisor"
  ],

  // Sequential order matters: search -> comparison -> recommendation.
  "tasks": [
    {
      "name": "product_search",
      "description": "Research the user's request: {product_query}\n\nUse Exa Search to find candidate products and the website-reading tool to verify product pages. Find up to five UNIQUE products that match the user's budget, intended use, preferred features, and buyer location, or fewer when the user explicitly requests a lower count. A different seller or cosmetic variation of the same model does not count as a unique product unless the specifications materially differ.\n\nFor every product, capture: exact product name/model, listed price and original currency, key specifications, seller/store, availability, warranty, shipping cost and Cambodia delivery status when relevant, and the direct product URL. Include the source URL for every product and factual shopping claim.\n\nEfficiency limits:\n- Use one focused Exa search first and no more than two Exa searches total.\n- Open only the most promising direct product pages. Verify no more than five usable product pages plus one replacement page if a candidate is blocked, duplicated, or irrelevant.\n- Stop using tools as soon as the requested number of products is verified or the limits above are reached.\n- Keep notes compact. Do not copy long website passages into the result.\n\nReliability rules:\n- Never invent or estimate a price, discount, seller, review score, stock status, warranty, shipping cost, or URL.\n- Open only HTTP(S) URLs returned by Exa Search. Never construct, guess, or modify retailer or product URLs from memory.\n- If Exa returns an authentication/API error or no usable results, stop searching and clearly report that verified product research could not be completed. Do not fall back to guessed retailer pages.\n- Use \"Not provided\" or \"Could not verify\" for missing facts; an unknown shipping cost is not zero.\n- Exclude malformed URLs and clearly note pages that are unavailable, blocked, stale, CAPTCHA-protected, or empty.\n- Keep currencies as listed. Do not convert currencies unless a cited conversion rate is available.\n- Deduplicate products by model and material specifications.\n- If fewer products can be verified within the tool limits, return the verified products and explicitly state the shortfall instead of fabricating entries.",
      "expected_output": "A compact markdown report with (1) the interpreted requirements, (2) a table of up to five unique verified products, or the count explicitly requested by the user when lower, with columns for product/model, price and currency, essential specifications, seller, availability, warranty, shipping/Cambodia delivery, and direct source URL, and (3) brief verification notes listing missing data, duplicate exclusions, unavailable pages, invalid URLs, and any fact that could not be verified. Do not include raw search results or long website excerpts.",
      "agent": "product_search_specialist"
    },
    {
      "name": "price_comparison",
      "description": "Using the verified Product Search context for {product_query}, compare the candidate products. For each product analyze listed price, discount (only when both original and sale prices are sourced), shipping cost, total known purchase cost, warranty, seller reliability evidence, return policy, advantages, and disadvantages.\n\nNormally use only the Product Search evidence. Use Exa Search only when one critical fact would change the winner and is missing, stale, or conflicting. Make at most one targeted Exa verification search, include its source URL, and do not perform broad new product discovery or repeat searches already completed by Product Search.\n\nCalculate total cost only when all included components use the same currency. If shipping, tax, import duty, or another required component is unknown, label the total \"Incomplete — missing ...\" and never treat the missing amount as zero. Do not mix currencies in a numerical price range. Identify a normal price range only from comparable, verified products in the same currency and explain the sample used. Mark seller reliability or return policy \"Could not verify\" when the evidence does not establish it.\n\nChoose a best-value deal only when its price, seller, and URL are verified. Keep the comparison concise and never invent products, prices, sellers, reviews, stock claims, or purchase links.",
      "expected_output": "A markdown comparison table covering price, sourced discount, shipping, total cost or incomplete-cost reason, warranty, seller reliability, return policy, advantages, and disadvantages for every candidate. Follow it with a same-currency normal price range (or a clear explanation that one cannot be calculated), the best-value verified deal with its exact source URL, and a limitations section for inconsistent currencies or missing information.",
      "agent": "price_comparison_analyst",
      "context": ["product_search"]
    },
    {
      "name": "final_recommendation",
      "description": "Using ONLY the Product Search and Price Comparison context for {product_query}, produce the final buying recommendation as Markdown following this exact section order:\n\n# Smart Shopping Recommendation\n\n## User Requirements\n- Product\n- Budget\n- Buyer location\n- Important preferences\n- Research date\n\n## Final Recommendation\n- Exact product/model\n- Verified price and currency\n- Seller\n- Availability\n- Warranty\n- Delivery information\n- Direct purchase/source URL\n- Short \"Why it wins\" explanation\n\n## Top Alternatives\nA compact Markdown table: Rank | Product | Price | Seller | Main advantage | Verification status | Source URL\n\n## Advantages\nA short bullet list based only on verified evidence.\n\n## Limitations and Unverified Information\nClearly identify every fact that could not be verified.\n\n## Final Buying Checklist\nInclude exact model/SKU, current price, stock, delivery cost, taxes, warranty, return policy, seller identity, and secure payment verification.\n\n## Sources\nA numbered list containing product names and their exact source URLs.\n\nPut Final Recommendation immediately after User Requirements so the most important result appears near the top. Keep every section short: no long paragraphs and no repeated facts across sections.\n\nDo not create or alter prices, URLs, review scores, seller claims, stock status, warranty terms, or shipping claims. Use \"Could not verify\" for any missing or unconfirmed fact instead of guessing or estimating. Preserve currencies exactly as listed in the prior task context; never convert or invent a currency. If the evidence is insufficient for a confident purchase recommendation, say so in Limitations and Unverified Information and explain what the buyer must verify before paying.",
      "expected_output": "A markdown report starting with the heading '# Smart Shopping Recommendation' and containing, in this order, the sections User Requirements, Final Recommendation, Top Alternatives (a Rank | Product | Price | Seller | Main advantage | Verification status | Source URL table), Advantages, Limitations and Unverified Information, Final Buying Checklist, and Sources (a numbered list of product names with their exact source URLs). Every fact must trace to the Product Search and Price Comparison context, with 'Could not verify' used for anything missing, currencies preserved exactly as sourced, and no fabricated prices, sellers, availability, reviews, warranties, shipping details, or URLs.",
      "agent": "product_recommendation_advisor",
      "context": ["product_search", "price_comparison"],
      "output_file": "report.md",
      "create_directory": true
    }
  ],

  "process": "sequential",
  "verbose": true,
  "memory": false,
  "planning": false,
  "cache": true,
  "tracing": false,
  "before_kickoff_callbacks": [
    {
      "python": "tools.runtime_checks.validate_runtime"
    }
  ],

  // A runnable sample default. Override it with `crewai run --inputs`.
  "inputs": {
    "product_query": "Find the best gaming laptop under $1000 available to a buyer in Cambodia. Compare at least five products and recommend the best value."
  }
}
